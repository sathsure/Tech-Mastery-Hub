{
    "name":  "tech-mastery-hub-ai-tutor",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "build":  "tsc",
                    "check":  "tsc --noEmit",
                    "start":  "node dist/index.js",
                    "tutor":  "node dist/interactive-tutor.js",
