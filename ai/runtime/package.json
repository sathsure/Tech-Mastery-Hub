                    "api-check":  "node dist/api-integration-test.js",
                    "response-check":  "node dist/response-validator-test.js",
                    "contribution-check":  "node dist/contribution-gateway-test.js",
                    "contribution-pipeline-check":  "node dist/contribution-pipeline-test.js",
                    "git-boundary-check":  "node dist/git-boundary-test.js",
                    "contribution-execution-check":  "node dist/contribution-execution-test.js",
                    "remote-contribution-check":  "node dist/remote-contribution-test.js",
                    "github-provider-check":  "node dist/github-provider-test.js",
                    "reindex-check":  "node dist/authoritative-reindex-test.js",
                    "post-merge-reindex-check":  "node dist/post-merge-reindex-test.js",
                    "github-post-merge-reindex-check":  "node dist/github-post-merge-reindex-test.js",
                    "manual-completion-check":  "node dist/manual-completion-guard-test.js",
                    "model-provider-check":  "node dist/model-provider-test.js",
                    "full-regression":  "node dist/full-regression-test.js",
