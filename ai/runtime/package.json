{
    "name": "tech-mastery-hub-ai-tutor",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "check": "tsc --noEmit",
        "start": "node dist/index.js",
        "tutor": "node dist/interactive-tutor.js",
        "api": "node dist/api-server.js --serve",
        "api-check": "node dist/api-integration-test.js",
        "response-check": "node dist/response-validator-test.js",
        "contribution-check": "node dist/contribution-gateway-test.js",
        "contribution-pipeline-check": "node dist/contribution-pipeline-test.js",
        "git-boundary-check": "node dist/git-boundary-test.js",
        "contribution-execution-check": "node dist/contribution-execution-test.js",
        "remote-contribution-check": "node dist/remote-contribution-test.js",
        "github-provider-check": "node dist/github-provider-test.js",
        "reindex-check": "node dist/authoritative-reindex-test.js",
        "post-merge-reindex-check": "node dist/post-merge-reindex-test.js",
        "github-post-merge-reindex-check": "node dist/github-post-merge-reindex-test.js",
        "manual-completion-check": "node dist/manual-completion-guard-test.js",
        "model-provider-check": "node dist/model-provider-test.js",
        "full-regression": "node dist/full-regression-test.js",
        "model-orchestration-check": "node dist/model-orchestration-test.js",
        "product-completion-check": "node dist/product-completion-test.js",
        "full-acceptance": "node dist/full-acceptance-test.js",
        "question-index": "node dist/question-indexer.js",
        "question-index-check": "node dist/question-indexer.js --check && node dist/question-index-test.js",
        "search": "node dist/question-search.js",
        "search-check": "node dist/question-search-test.js",
        "chat": "node dist/chat-cli.js",
        "chat-check": "node dist/chat-test.js",
        "roadmaps": "node dist/roadmap-generator.js && node dist/question-indexer.js",
        "roadmaps-check": "node dist/roadmap-generator.js --check",
        "atlas-check": "node ../../IT_Roles_Terminology_Atlas/pay-tax.test.js && node ../../IT_Roles_Terminology_Atlas/role-test.test.js"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.6.0",
        "@highlightjs/cdn-assets": "^11.12.0",
        "dompurify": "^3.4.17",
        "marked": "^18.1.3",
        "mermaid": "^12.3.0"
    }
}
